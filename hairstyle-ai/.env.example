# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# PLAY_LICENSE_KEY: Base64-encoded RSA public key from Play Console
# (Monetize with Play → Monetization setup → Licensing). Used to verify purchase signatures.
# It is a public key, so it is safe to include in the app.
PLAY_LICENSE_KEY=MY_PLAY_LICENSE_KEY

# UPDATE_MANIFEST_URL: public HTTPS URL of update.json for installs that did NOT come from Google Play
# (e.g. https://pub-xxxxxxxx.r2.dev/update.json or https://updates.example.com/update.json).
# This is a read-only public URL, never an S3 endpoint or credentials. Play installs use Play's updater.
UPDATE_MANIFEST_URL=MY_UPDATE_MANIFEST_URL
