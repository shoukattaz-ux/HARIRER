<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   API tokens are encrypted with a device-bound Android Keystore key, so they are never copied.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="paid_hairstyle_api_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="paid_hairstyle_api_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
